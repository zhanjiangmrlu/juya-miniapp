{
  "name": "juya-miniapp",
  "version": "0.1.0",
  "private": true,
  "description": "句芽英语多端应用",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.22.0 <23",
    "pnpm": "11.22.0"
  },
  "scripts": {
    "build": "pnpm build:mp-weixin",
    "build:h5": "uni build -p h5",
    "build:mp-weixin": "uni build -p mp-weixin && node scripts/verify-mp-page-meta.mjs",
    "build:mp-weixin:local": "uni build -p mp-weixin --mode development && node scripts/verify-mp-page-meta.mjs",
    "check": "pnpm format:check && pnpm lint && pnpm lint:style && pnpm typecheck",
    "dev:mp-weixin": "uni -p mp-weixin",
    "dev:h5": "uni -p h5",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "lint:style": "stylelint \"**/*.{vue,css,scss}\" --max-warnings=0",
    "lint:style:fix": "stylelint \"**/*.{vue,css,scss}\" --fix --max-warnings=0",
    "prepare": "simple-git-hooks",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-components": "3.0.0-5020620260917001",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020620260917001",
    "pinia": "2.1.7",
    "vue": "3.4.21",
    "vue-i18n": "9.1.9"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020620260917001",
    "@dcloudio/uni-h5": "3.0.0-5020620260917001",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020620260917001",
    "@eslint/js": "9.39.1",
    "@types/node": "22.20.4",
    "@vitejs/plugin-vue": "5.2.4",
    "@vue/compiler-sfc": "3.4.21",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.7.0",
    "agent-browser": "^0.38.1",
    "eslint": "9.39.1",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "60.0.0",
    "eslint-plugin-unused-imports": "4.4.1",
    "eslint-plugin-vue": "10.6.2",
    "happy-dom": "20.14.5",
    "lint-staged": "16.2.6",
    "postcss-html": "2.0.0",
    "prettier": "3.9.9",
    "sass": "1.77.8",
    "simple-git-hooks": "2.13.1",
    "stylelint": "17.15.0",
    "stylelint-config-recommended-vue": "2.0.0",
    "stylelint-config-standard-scss": "17.0.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "5.2.8",
    "vitest": "3.2.4",
    "vue-eslint-parser": "10.3.0",
    "vue-tsc": "2.2.12"
  },
  "lint-staged": {
    "*.{js,mjs,cjs,ts,tsx}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.vue": [
      "eslint --fix --max-warnings=0",
      "stylelint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,scss}": [
      "stylelint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": "prettier --write"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm exec lint-staged"
  }
}
