{
  "schema_version": 1,
  "kind": "web",
  "project": "juya-miniapp-h5",
  "repository": "juya-miniapp",
  "site_output": "dist/build/h5",
  "checks": [
    ["pnpm", "install", "--frozen-lockfile"],
    ["pnpm", "check"],
    ["pnpm", "test"]
  ],
  "build": {
    "test": {
      "command": ["pnpm", "build:h5"],
      "env": {
        "VITE_API_BASE_URL": "https://test-h5.juyayingyu.com"
      }
    },
    "production": {
      "command": ["pnpm", "build:h5"],
      "env": {
        "VITE_API_BASE_URL": "https://h5.juyayingyu.com"
      }
    }
  }
}
